    [0, 1],
    [0, 1],
    linestyle="--",
    label="Random Classifier"
)

plt.xlabel("False Positive Rate")
plt.ylabel("True Positive Rate")
plt.title("ROC Curve")
plt.legend()
plt.grid()
plt.show()

print("AUC:", auc_score)


# ==========================================
# TASK 3: PRECISION-RECALL CURVE
# ==========================================

precision, recall, thresholds = precision_recall_curve(
    y_test,
    y_prob
)

plt.figure(figsize=(8, 6))

plt.plot(
    recall,
    precision,
    label="Precision-Recall Curve"
)

plt.xlabel("Recall")
plt.ylabel("Precision")
plt.title("Precision-Recall Curve")
plt.legend()
plt.grid()
plt.show()


# ==========================================
# TASK 4: LOG LOSS
# ==========================================

loss = log_loss(
    y_test,
    y_prob
)

print("Log Loss:", loss)


# ==========================================
# TASK 5: 2% POSITIVE CLASS
# ==========================================

normal = df[df["Class"] == 0]
fraud = df[df["Class"] == 1]

fraud_sample = fraud.sample(
    n=min(49, len(fraud)),
    random_state=42
)

normal_sample = normal.sample(
    n=min(2401, len(normal)),
    random_state=42
)

imbalanced_test = pd.concat(
    [normal_sample, fraud_sample]
).sample(
    frac=1,
    random_state=42
)

X_imbalanced = imbalanced_test.drop(
    "Class",
    axis=1
)

y_imbalanced = imbalanced_test["Class"]

X_imbalanced_scaled = scaler.transform(
    X_imbalanced
)

y_imbalanced_prob = model.predict_proba(
    X_imbalanced_scaled
)[:, 1]

y_imbalanced_pred = model.predict(
    X_imbalanced_scaled
)

accuracy = accuracy_score(
    y_imbalanced,
    y_imbalanced_pred
)

auc = roc_auc_score(
    y_imbalanced,
    y_imbalanced_prob
)

loss = log_loss(
    y_imbalanced,
    y_imbalanced_prob
)

print("\n2% IMBALANCED TEST SET")
print(
    "Positive Class:",
    y_imbalanced.mean() * 100,
